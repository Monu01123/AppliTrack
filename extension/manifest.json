{
  "manifest_version": 3,
  "name": "HireIQ Job Clipper",
  "version": "1.0",
  "description": "Instantly save jobs from LinkedIn, Indeed, and more directly to your HireIQ Tracker.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://localhost:5000/*",
    "https://*/*",
    "http://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
